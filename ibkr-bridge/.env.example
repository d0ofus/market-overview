# Copy to .env on the bridge machine. Do not commit .env.

# Required. Generate with scripts/generate-bridge-token.ps1.
IBKR_BRIDGE_TOKEN=replace-with-strong-random-token

# Bridge HTTP listener. Keep host on 127.0.0.1 because Cloudflare Tunnel runs on
# the same machine and exposes it privately.
IBKR_BRIDGE_HOST=127.0.0.1
IBKR_BRIDGE_PORT=8765

# IB Gateway/TWS API socket.
# Common defaults:
# - IB Gateway paper: 4002
# - IB Gateway live: 4001
# - TWS paper: 7497
# - TWS live: 7496
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=7712
IBKR_READONLY=true
IBKR_ACCOUNT=

# Market data mode: 1 realtime, 2 frozen, 3 delayed, 4 delayed frozen.
IBKR_MARKET_DATA_TYPE=1

# Chain construction and pacing.
IBKR_CHAIN_MONEYNESS_PCT=0.35
IBKR_MAX_CONTRACTS_PER_TICKER=800
IBKR_MARKET_SNAPSHOT_SECONDS=3.0
IBKR_HISTORICAL_REQUEST_SPACING_SECONDS=1.0
IBKR_CONNECT_TIMEOUT_SECONDS=8.0

